# ---------------------------------------------------------------------------
# LMCache + vLLM + cuObject S3 RDMA Docker Image
#
# Base: vllm/vllm-openai (includes PyTorch + CUDA runtime + vLLM)
# Adds: LMCache from source with cuObject pybind11 extension
# cuObjClient SDK installed from NVIDIA redistributable tarball (~150 KB)
# ---------------------------------------------------------------------------
FROM vllm/vllm-openai:latest AS base

# ---------------------------------------------------------------------------
# Stage 1: Install cuObjClient SDK from NVIDIA redistributable
#
# Instead of installing the full CUDA 13.1 toolkit (~4 GB), we download
# only the cuObjClient library tarball (~150 KB) and the cuFile library
# (~43 MB) from NVIDIA's redistrib endpoint. These are extracted to
# /opt/cuobject/ and used for both build and runtime.
# ---------------------------------------------------------------------------
ARG NVIDIA_REDIST_BASE=https://developer.download.nvidia.com/compute/cuda/redist
ARG CUOBJCLIENT_TARBALL=libcuobjclient/linux-x86_64/libcuobjclient-linux-x86_64-1.0.0.26-archive.tar.xz
ARG CUFILE_TARBALL=libcufile/linux-x86_64/libcufile-linux-x86_64-1.16.1.26-archive.tar.xz
ARG CUOBJECT_PREFIX=/opt/cuobject

USER root

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
        wget \
        git \
        xz-utils \
        libibverbs-dev \
        librdmacm-dev \
    && rm -rf /var/lib/apt/lists/*

# Install CUDA dev headers required to compile LMCache CUDA extensions.
# The vllm-openai base image ships only the CUDA runtime (no headers).
# We detect the CUDA version from nvcc and install the matching -dev packages.
RUN CUDA_VER=$(nvcc --version | grep -oP 'release \K[0-9]+\.[0-9]+') \
    && CUDA_VER_DASH=$(echo $CUDA_VER | tr '.' '-') \
    && echo "Detected CUDA ${CUDA_VER}, installing dev headers..." \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends \
        libcusparse-dev-${CUDA_VER_DASH} \
        libcublas-dev-${CUDA_VER_DASH} \
        libcusolver-dev-${CUDA_VER_DASH} \
        libcurand-dev-${CUDA_VER_DASH} \
        cuda-cudart-dev-${CUDA_VER_DASH} \
    && rm -rf /var/lib/apt/lists/*

# Download and extract cuObjClient SDK (header + shared lib)
RUN mkdir -p ${CUOBJECT_PREFIX}/include ${CUOBJECT_PREFIX}/lib \
    && wget -q "${NVIDIA_REDIST_BASE}/${CUOBJCLIENT_TARBALL}" -O /tmp/cuobjclient.tar.xz \
    && tar -xf /tmp/cuobjclient.tar.xz -C /tmp \
    && cp /tmp/libcuobjclient-*/include/* ${CUOBJECT_PREFIX}/include/ \
    && cp /tmp/libcuobjclient-*/lib/* ${CUOBJECT_PREFIX}/lib/ \
    && rm -rf /tmp/cuobjclient.tar.xz /tmp/libcuobjclient-*

# Download and extract cuFile library (runtime dependency of cuObjClient)
RUN wget -q "${NVIDIA_REDIST_BASE}/${CUFILE_TARBALL}" -O /tmp/cufile.tar.xz \
    && tar -xf /tmp/cufile.tar.xz -C /tmp \
    && cp /tmp/libcufile-*/include/* ${CUOBJECT_PREFIX}/include/ 2>/dev/null || true \
    && cp /tmp/libcufile-*/lib/* ${CUOBJECT_PREFIX}/lib/ 2>/dev/null || true \
    && cp -r /tmp/libcufile-*/lib/x86_64-linux-gnu/* ${CUOBJECT_PREFIX}/lib/ 2>/dev/null || true \
    && rm -rf /tmp/cufile.tar.xz /tmp/libcufile-*

# Verify cuobjclient.h is present
RUN test -f ${CUOBJECT_PREFIX}/include/cuobjclient.h \
    && echo "cuObjClient SDK found at ${CUOBJECT_PREFIX}" \
    && ls -la ${CUOBJECT_PREFIX}/include/cuobjclient.h \
    && ls -la ${CUOBJECT_PREFIX}/lib/ \
    || (echo "ERROR: cuobjclient.h not found" && exit 1)

# ---------------------------------------------------------------------------
# Stage 2: Install LMCache from source with cuObject extension
#
# CUOBJECT_INCLUDE_DIR / CUOBJECT_LIB_DIR point at the extracted SDK.
# CUDA_HOME stays at the base image's CUDA (used by PyTorch extensions).
# The cuObject pybind11 extension (lmcache_cuobject) is a CppExtension,
# not a CUDAExtension, so it only needs the C++ compiler + cuobjclient.h.
# ---------------------------------------------------------------------------
ARG LMCACHE_REPO=https://github.com/LMCache/LMCache.git
ARG LMCACHE_BRANCH=dev

WORKDIR /opt

RUN git clone --depth 1 --branch ${LMCACHE_BRANCH} ${LMCACHE_REPO} /opt/lmcache

WORKDIR /opt/lmcache

# Build LMCache with cuObject extension
# Use hardcoded paths -- ARG values are not available in ENV substitution
ENV CUOBJECT_INCLUDE_DIR=/opt/cuobject/include
ENV CUOBJECT_LIB_DIR=/opt/cuobject/lib

# Debug: verify SDK is reachable before build
RUN echo "CUOBJECT_INCLUDE_DIR=${CUOBJECT_INCLUDE_DIR}" \
    && echo "CUOBJECT_LIB_DIR=${CUOBJECT_LIB_DIR}" \
    && ls -la ${CUOBJECT_INCLUDE_DIR}/cuobjclient.h \
    && ls -la ${CUOBJECT_LIB_DIR}/

RUN pip install --no-cache-dir -e . --no-build-isolation \
    && python3 -c "import torch; from lmcache.lmcache_cuobject import CuObjectClient; print('cuObject extension: OK')" \
    && echo "LMCache installed successfully with cuObject support"

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------

# Ensure libcuobjclient.so is findable at runtime
ENV LD_LIBRARY_PATH="/opt/cuobject/lib:${LD_LIBRARY_PATH}"

# Default LMCache settings (can be overridden at runtime)
ENV PYTHONHASHSEED=0
ENV LMCACHE_MAX_LOCAL_CPU_SIZE=66

WORKDIR /workspace

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
