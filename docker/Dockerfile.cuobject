# LMCache + vLLM + cuObject S3 RDMA Docker Image
#
# Dual CUDA: 12.8 for vLLM/PyTorch, 13.1 for cuObject extension.
# Both toolkits coexist under /usr/local/cuda-{12.8,13.1}.
#
# Build from repo root:
#   docker build --target image-build \
#       -f docker/Dockerfile.cuobject \
#       -t lmcache/vllm-cuobject:latest .
#
# To use a custom NIXL branch (e.g. Pattern B refactoring):
#   docker build --target image-build \
#       --build-arg NIXL_BRANCH=feature-isse-1464-replace-callback-design \
#       --build-arg NIXL_REPO=https://github.com/your-fork/nixl.git \
#       -t lmcache/vllm-cuobject:latest .

ARG CUDA_VERSION=12.8
ARG CUDA_CUOBJ_VERSION=13.1
ARG UBUNTU_VERSION=24.04

#################### BASE BUILD IMAGE ####################

FROM nvcr.io/nvidia/cuda-dl-base:25.03-cuda${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS base

ARG CUDA_VERSION
ARG CUDA_CUOBJ_VERSION
ARG PYTHON_VERSION=3.12
ARG UBUNTU_VERSION
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/venv/bin:${PATH}"

RUN echo 'tzdata tzdata/Areas select America' | debconf-set-selections \
    && echo 'tzdata tzdata/Zones/America select Los_Angeles' | debconf-set-selections \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends \
        ccache software-properties-common git curl sudo wget \
        python3 python3-dev python3-venv python3-pip tzdata libxcb1-dev \
        libibverbs-dev librdmacm-dev \
        # aws-sdk-cpp build dependencies (needed for NIXL OBJ plugin)
        cmake libcurl4-openssl-dev libssl-dev uuid-dev zlib1g-dev \
        pkg-config build-essential \
    && ldconfig /usr/local/cuda-$(echo $CUDA_VERSION | cut -d. -f1,2)/compat/ \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv ~/.local/bin/uv /usr/local/bin/ \
    && mv ~/.local/bin/uvx /usr/local/bin/ \
    && uv venv /opt/venv \
    && . /opt/venv/bin/activate \
    && python3 --version

# Install CUDA 13.1 toolkit alongside 12.8 (toolkit only, no driver)
RUN CUDA_CUOBJ_DASH=$(echo ${CUDA_CUOBJ_VERSION} | tr '.' '-') \
    && wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm cuda-keyring_1.1-1_all.deb \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends \
        cuda-toolkit-${CUDA_CUOBJ_DASH} \
    && rm -rf /var/lib/apt/lists/* \
    && ls /usr/local/cuda-${CUDA_CUOBJ_VERSION}/include/cuobjclient.h \
    && echo "CUDA ${CUDA_CUOBJ_VERSION} installed at /usr/local/cuda-${CUDA_CUOBJ_VERSION}"

# CUDA_HOME stays on 12.8 for PyTorch/vLLM
ENV CUDA_HOME=/usr/local/cuda-${CUDA_VERSION}

# ---------------------------------------------------------------------------
# Build aws-sdk-cpp from source (required for NIXL OBJ plugin).
# Not available as a system package on Ubuntu 24.04.
# Only the S3 and S3-CRT modules are needed (~3 min build).
# ---------------------------------------------------------------------------
ARG AWS_SDK_CPP_VERSION=1.11.760
RUN git clone --recurse-submodules --depth 1 --shallow-submodules \
        --branch ${AWS_SDK_CPP_VERSION} \
        https://github.com/aws/aws-sdk-cpp.git /tmp/aws-sdk-cpp \
    && mkdir -p /tmp/aws-sdk-cpp/build && cd /tmp/aws-sdk-cpp/build \
    && cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_ONLY="s3;s3-crt" \
        -DENABLE_TESTING=OFF \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_SHARED_LIBS=ON \
    && make -j$(nproc) && make install \
    && ldconfig \
    && cd / && rm -rf /tmp/aws-sdk-cpp

# ---------------------------------------------------------------------------
# Build NIXL from source with OBJ plugin + Dell cuObject RDMA support.
#
# The OBJ plugin requires:
#   - aws-cpp-sdk-s3, aws-cpp-sdk-s3-crt, aws-cpp-sdk-core (built above)
#   - cuobjclient-13.1 (from CUDA 13.1 toolkit, found via pkg-config)
#
# NIXL native libs + plugins are built here; the Python wheel is built but
# NOT installed until after vLLM (which pulls PyPI nixl-cu12 as a dep).
# Our custom wheel is force-reinstalled post-vLLM to overwrite the PyPI copy.
# ---------------------------------------------------------------------------
ARG NIXL_REPO=https://github.com/ai-dynamo/nixl.git
ARG NIXL_BRANCH=main
ARG NIXL_PREFIX=/opt/nixl

RUN git clone --depth 1 --branch ${NIXL_BRANCH} ${NIXL_REPO} /tmp/nixl-src

# Tell pkg-config where to find cuobjclient-13.1.pc from the CUDA 13.1 toolkit
ENV PKG_CONFIG_PATH="/usr/local/cuda-${CUDA_CUOBJ_VERSION}/lib64/pkgconfig:${PKG_CONFIG_PATH:-}"

# Install NIXL Python build dependencies
RUN . /opt/venv/bin/activate \
    && uv pip install meson-python meson ninja pybind11 patchelf pyyaml types-PyYAML tomlkit

# Native build (meson + ninja)
RUN cd /tmp/nixl-src \
    && . /opt/venv/bin/activate \
    && meson setup /tmp/nixl-build \
        --prefix=${NIXL_PREFIX} \
        --buildtype=release \
        -Dcudapath_lib="${CUDA_HOME}/lib64" \
        -Dcudapath_inc="${CUDA_HOME}/include" \
    && ninja -C /tmp/nixl-build \
    && ninja -C /tmp/nixl-build install

# Register native libraries so plugins are found at runtime
RUN echo "${NIXL_PREFIX}/lib/x86_64-linux-gnu" > /etc/ld.so.conf.d/nixl.conf \
    && echo "${NIXL_PREFIX}/lib/x86_64-linux-gnu/plugins" >> /etc/ld.so.conf.d/nixl.conf \
    && ldconfig \
    && ls ${NIXL_PREFIX}/lib/x86_64-linux-gnu/plugins/libplugin_OBJ.so \
    && echo "NIXL OBJ plugin: OK" \
    && echo "Installed plugins:" \
    && ls -1 ${NIXL_PREFIX}/lib/x86_64-linux-gnu/plugins/

# Build Python wheel (but do NOT install yet).
# Keep the default name "nixl-cu12" — do NOT rename to nixl-cu13.
# vLLM declares nixl as a dependency and will pull nixl-cu12 from PyPI.
# We force-reinstall our custom wheel AFTER vLLM to overwrite the PyPI
# version with one whose libnixl.so knows about the OBJ plugin.
RUN . /opt/venv/bin/activate \
    && mkdir -p /tmp/nixl-wheels \
    && uv build /tmp/nixl-src --wheel --out-dir /tmp/nixl-wheels --python 3.12 \
        -Csetup-args="-Dcudapath_lib=${CUDA_HOME}/lib64" \
        -Csetup-args="-Dcudapath_inc=${CUDA_HOME}/include" \
    && ls -1 /tmp/nixl-wheels/ \
    && echo "Custom nixl-cu12 wheel built (will be installed after vLLM)"

# Verify the native OBJ plugin was built with cuobjclient (RDMA acceleration).
# Plugins are NOT inside the Python wheel — they're loaded at runtime from the
# native install at NIXL_PREFIX via LD_LIBRARY_PATH.
RUN OBJ_PLUGIN="${NIXL_PREFIX}/lib/x86_64-linux-gnu/plugins/libplugin_OBJ.so" \
    && echo "Checking OBJ plugin at: ${OBJ_PLUGIN}" \
    && ldd "${OBJ_PLUGIN}" | grep cuobjclient \
    && echo "cuobjclient linked: OK (RDMA acceleration enabled)" \
    || (echo "ERROR: OBJ plugin missing cuobjclient linkage — RDMA acceleration will NOT work!" \
        && echo "ldd output:" && ldd "${OBJ_PLUGIN}" && exit 1)

# Tell nixl to load plugins from the native build (not relative to the Python .so)
ENV NIXL_PLUGIN_DIR="${NIXL_PREFIX}/lib/x86_64-linux-gnu/plugins"

# NIXL runtime library paths (include CUDA 13.1 for libcuobjclient.so)
ENV LD_LIBRARY_PATH="${NIXL_PREFIX}/lib/x86_64-linux-gnu:${NIXL_PREFIX}/lib/x86_64-linux-gnu/plugins:/usr/local/cuda-${CUDA_CUOBJ_VERSION}/lib64:${LD_LIBRARY_PATH:-}"

WORKDIR /workspace

COPY ./requirements/common.txt common.txt
COPY ./requirements/cuda.txt cuda.txt
COPY ./requirements/cuda_core.txt cuda_core.txt
# Filter out the "nixl" line from common.txt so cuda.txt does not pull nixl
# from PyPI during the base stage.  Our custom nixl-cu12 wheel is installed
# later (after vLLM) to overwrite whatever PyPI version vLLM brings in.
RUN sed -i '/^nixl/d' common.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    . /opt/venv/bin/activate && \
    uv pip install -r cuda.txt

ARG torch_cuda_arch_list='7.0 7.5 8.0 8.6 8.9 9.0 10.0+PTX'
ENV TORCH_CUDA_ARCH_LIST=${torch_cuda_arch_list}

#################### vLLM + LMCache + cuObject (Build) ####################

FROM base AS image-build

ARG CUDA_CUOBJ_VERSION

COPY ./requirements/build.txt build.txt

ARG max_jobs=2
ENV MAX_JOBS=${max_jobs}

ARG nvcc_threads=8
ENV NVCC_THREADS=$nvcc_threads

ARG VLLM_VERSION=0.19.0

RUN --mount=type=cache,target=/root/.cache/pip \
    . /opt/venv/bin/activate && \
    uv pip install -r build.txt

ARG LMCACHE_COMMIT_ID=1

COPY . /workspace/LMCache
WORKDIR /workspace/LMCache

# cuObject extension builds against CUDA 13.1 SDK
ENV CUOBJECT_INCLUDE_DIR=/usr/local/cuda-${CUDA_CUOBJ_VERSION}/include
ENV CUOBJECT_LIB_DIR=/usr/local/cuda-${CUDA_CUOBJ_VERSION}/lib64
# 13.1 MUST come first so libcufile.so resolves from 13.1 (has cuFileRDMADescStrGet)
ENV LD_LIBRARY_PATH="/usr/local/cuda-${CUDA_CUOBJ_VERSION}/lib64:/usr/local/cuda-12.8/lib64:${LD_LIBRARY_PATH}"

RUN --mount=type=cache,target=/root/.cache/ccache,id=ccache \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache,sharing=locked \
    . /opt/venv/bin/activate && \
    if [ "$VLLM_VERSION" = "nightly" ]; then \
        uv pip install --prerelease=allow \
            'vllm[runai,tensorizer,flashinfer]' \
            'triton-kernels @ git+https://github.com/triton-lang/triton.git@v3.5.0#subdirectory=python/triton_kernels' \
            --extra-index-url https://wheels.vllm.ai/nightly \
            --index-strategy unsafe-best-match ; \
    else \
        uv pip install --prerelease=allow \
            "vllm[runai,tensorizer,flashinfer]==${VLLM_VERSION}" \
            'triton-kernels @ git+https://github.com/triton-lang/triton.git@v3.5.0#subdirectory=python/triton_kernels' ; \
    fi && \
    python3 -c 'import torch; print("TORCH=", torch.__version__)'

# ---- Overwrite PyPI nixl-cu12 with our custom-built wheel ----
# vLLM just installed nixl-cu12 from PyPI (no OBJ plugin support).
# Force-reinstall our custom wheel so _bindings.so and libnixl.so come from
# the same source tree as the native-built plugins in NIXL_PLUGIN_DIR.
RUN . /opt/venv/bin/activate && \
    echo "Overwriting PyPI nixl-cu12 with custom build..." && \
    uv pip install /tmp/nixl-wheels/nixl_cu12*.whl --force-reinstall --no-deps && \
    python3 -c "import nixl_cu12, os; print('nixl_cu12 path:', nixl_cu12.__path__); plugin_dir = os.environ.get('NIXL_PLUGIN_DIR', ''); obj_plugin = os.path.join(plugin_dir, 'libplugin_OBJ.so'); assert os.path.exists(obj_plugin), f'OBJ plugin not at {obj_plugin}'; print('OBJ plugin verified:', obj_plugin); print('Custom nixl-cu12 installed OK')"

# Replace PyTorch's bundled libcufile.so (12.8, no RDMA symbols) with
# the CUDA 13.1 version (has cuFileRDMADescStrGet needed by cuObjClient).
# PyTorch's RPATH resolves libcufile from its pip package directory before
# LD_LIBRARY_PATH, so the only way to override it is to replace in-place.
ARG CUDA_CUOBJ_VERSION
RUN . /opt/venv/bin/activate && \
    uv pip install nvidia-cufile-cu12
RUN TORCH_CUFILE_DIR=$(python3 -c "import nvidia.cufile; print(nvidia.cufile.__path__[0])")/lib \
    && echo "Replacing PyTorch cufile at ${TORCH_CUFILE_DIR} with CUDA ${CUDA_CUOBJ_VERSION} version" \
    && ls -la ${TORCH_CUFILE_DIR}/libcufile* \
    && cp -a /usr/local/cuda-${CUDA_CUOBJ_VERSION}/lib64/libcufile*.so* ${TORCH_CUFILE_DIR}/ \
    && ls -la ${TORCH_CUFILE_DIR}/libcufile*

ENV CUFILE_ENV_PATH_JSON=/workspace/cufile.json

RUN . /opt/venv/bin/activate && \
    TORCH_CUDA=$(python3 -c "import torch; print(torch.version.cuda)") && \
    echo "PyTorch CUDA version: ${TORCH_CUDA}" && \
    export CUDA_HOME=/usr/local/cuda-${TORCH_CUDA} && \
    echo "CUDA_HOME=${CUDA_HOME}" && \
    echo "CUOBJECT_INCLUDE_DIR=${CUOBJECT_INCLUDE_DIR}" && \
    echo "CUOBJECT_LIB_DIR=${CUOBJECT_LIB_DIR}" && \
    python3 setup.py bdist_wheel --dist-dir=dist_lmcache && \
    uv pip install ./dist_lmcache/*.whl --no-deps --verbose && \
    python3 -c "import torch; from lmcache.lmcache_cuobject import CuObjectClient; print('cuObject extension: OK')"

WORKDIR /workspace
RUN cp /workspace/LMCache/docker/entrypoint_cuobject.sh /entrypoint.sh \
    && chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
